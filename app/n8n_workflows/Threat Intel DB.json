    {
      "parameters": {
        "jsCode": "const rawData = $input.all()[0].json.data;\n\n// IPv4 regex pattern\nconst ipRegex = /^(\\d{1,3}\\.){3}\\d{1,3}$/;\n\nconst lines = String(rawData).split('\\n');\nconst results = [];\n\nfor (let line of lines) {\n  const cleanLine = line.replace('\\r', '').trim();\n\n  // Skip empty lines and comment lines starting with #\n  if (!cleanLine || cleanLine.startsWith('#')) {\n    continue;\n  }\n\n  const isIp = ipRegex.test(cleanLine);\n  const indicatorType = isIp ? 'ip' : 'domain';\n\n  results.push({\n    indicator: cleanLine,\n    type: indicatorType\n  });\n}\n\nreturn results;"
      },
