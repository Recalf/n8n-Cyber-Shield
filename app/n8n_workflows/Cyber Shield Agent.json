    {
      "parameters": {
        "jsCode": "const connections = $('Webhook').first().json.body;\nconst hits = $input.all().map(i => i.json);\n\nconst alerts = [];\n\nfor (const conn of connections) {\n\n    const ipHits = hits.filter(h =>\n        h.type === 'ip' &&\n        h.indicator === conn.dst_ip\n    );\n\n    const domainHits = hits.filter(h =>\n        h.type === 'domain' &&\n        h.indicator === conn.domain\n    );\n\n    if (ipHits.length || domainHits.length) {\n\n        let intel = '';\n\n        if (ipHits.length && domainHits.length) {\n            intel = `High Risk: Malicious IP (${conn.dst_ip}) and domain (${conn.domain}) detected`;\n        } \n        else if (domainHits.length) {\n            intel = `Medium Risk: Malicious domain detected (${conn.domain})`;\n        } \n        else if (ipHits.length) {\n            intel = `Medium Risk: Malicious IP detected (${conn.dst_ip})`;\n        }\n\n        alerts.push({\n            connection: conn,\n            ipHits,\n            domainHits,\n            intel\n        });\n    }\n}\n\nreturn alerts.map(a => ({ json: a }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
